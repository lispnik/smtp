(in-package #:smtp)

(defparameter *mime-types*
  (let ((table (make-hash-table :test 'equalp)))
    (loop for (type . extensions)
            in '(("text/plain" "txt" "text" "log" "conf" "lisp" "asd" "md")
                 ("text/html" "html" "htm")
                 ("text/css" "css")
                 ("text/csv" "csv")
                 ("text/calendar" "ics")
                 ("text/vcard" "vcf")
                 ("text/xml" "xml")
                 ("text/markdown")
                 ("application/pdf" "pdf")
                 ("application/json" "json")
                 ("application/zip" "zip")
                 ("application/gzip" "gz" "tgz")
                 ("application/x-tar" "tar")
                 ("application/x-7z-compressed" "7z")
                 ("application/vnd.rar" "rar")
                 ("application/rtf" "rtf")
                 ("application/msword" "doc")
                 ("application/vnd.openxmlformats-officedocument.wordprocessingml.document" "docx")
                 ("application/vnd.ms-excel" "xls")
                 ("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" "xlsx")
                 ("application/vnd.ms-powerpoint" "ppt")
                 ("application/vnd.openxmlformats-officedocument.presentationml.presentation" "pptx")
                 ("application/vnd.oasis.opendocument.text" "odt")
                 ("application/vnd.oasis.opendocument.spreadsheet" "ods")
                 ("application/vnd.oasis.opendocument.presentation" "odp")
                 ("application/epub+zip" "epub")
                 ("application/javascript" "js" "mjs")
                 ("application/wasm" "wasm")
                 ("application/pgp-signature" "sig" "asc")
                 ("application/x-pem-file" "pem")
                 ("application/pkix-cert" "cer" "crt")
                 ("application/pkcs7-signature" "p7s")
                 ("application/pkcs7-mime" "p7m")
                 ("image/png" "png")
                 ("image/jpeg" "jpg" "jpeg" "jpe")
                 ("image/gif" "gif")
                 ("image/webp" "webp")
                 ("image/avif" "avif")
                 ("image/heic" "heic")
                 ("image/svg+xml" "svg")
                 ("image/bmp" "bmp")
                 ("image/tiff" "tif" "tiff")
                 ("image/x-icon" "ico")
                 ("audio/mpeg" "mp3")
                 ("audio/ogg" "ogg" "oga")
                 ("audio/wav" "wav")
                 ("audio/flac" "flac")
                 ("audio/aac" "aac")
                 ("audio/mp4" "m4a")
                 ("video/mp4" "mp4" "m4v")
                 ("video/webm" "webm")
                 ("video/quicktime" "mov")
                 ("video/x-msvideo" "avi")
                 ("font/woff" "woff")
                 ("font/woff2" "woff2")
                 ("font/ttf" "ttf")
                 ("font/otf" "otf"))
          do (dolist (ext extensions) (setf (gethash ext table) type)))
    table)
  "File extension to media type. Add entries with (SETF GETHASH).")

(defun mime-type-for-filename (filename)
  "The media type for FILENAME's extension, or application/octet-stream."
  (let* ((name (if (pathnamep filename) (file-namestring filename) filename))
         (dot (position #\. name :from-end t)))
    (or (and dot (gethash (subseq name (1+ dot)) *mime-types*))
        "application/octet-stream")))
